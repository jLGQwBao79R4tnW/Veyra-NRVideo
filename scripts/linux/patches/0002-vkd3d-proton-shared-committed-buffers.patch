diff --git a/libs/vkd3d/memory.c b/libs/vkd3d/memory.c
index 712b0b75..7d20c47d 100644
--- a/libs/vkd3d/memory.c
+++ b/libs/vkd3d/memory.c
@@ -1307,11 +1307,22 @@ static bool vkd3d_is_imported_allocation(const struct vkd3d_allocate_memory_info
     return false;
 }
 
+static bool vkd3d_has_export_info(const void *pnext)
+{
+    const VkBaseInStructure *next = pnext;
+
+    for (; next; next = next->pNext)
+        if (next->sType == VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO)
+            return true;
+    return false;
+}
+
 static HRESULT vkd3d_memory_allocation_init(struct vkd3d_memory_allocation *allocation, struct d3d12_device *device,
         struct vkd3d_memory_allocator *allocator, const struct vkd3d_allocate_memory_info *info)
 {
     const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
     VkMemoryPriorityAllocateInfoEXT priority_info;
+    VkMemoryDedicatedAllocateInfo dedicated_info;
     VkMemoryRequirements memory_requirements;
     VkMemoryAllocateFlagsInfo flags_info;
     VkMemoryPropertyFlags type_flags;
@@ -1401,6 +1412,18 @@ static HRESULT vkd3d_memory_allocation_init(struct vkd3d_memory_allocation *allo
     flags_info.pNext = info->pNext;
     flags_info.flags = 0;
 
+    if (allocation->resource.vk_buffer && !info->explicit_global_buffer_usage &&
+            vkd3d_has_export_info(info->pNext))
+    {
+        /* Exported buffer memory (shared committed buffer) is a dedicated allocation of that buffer,
+         * which external importers (e.g. CUDA with CUDA_EXTERNAL_MEMORY_DEDICATED) expect. */
+        dedicated_info.sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO;
+        dedicated_info.pNext = flags_info.pNext;
+        dedicated_info.image = VK_NULL_HANDLE;
+        dedicated_info.buffer = allocation->resource.vk_buffer;
+        flags_info.pNext = &dedicated_info;
+    }
+
     if (device->device_info.zero_initialize_device_memory_features.zeroInitializeDeviceMemory &&
             !(info->heap_flags & D3D12_HEAP_FLAG_CREATE_NOT_ZEROED))
     {
diff --git a/libs/vkd3d/resource.c b/libs/vkd3d/resource.c
index e521ec69..dd2caf84 100644
--- a/libs/vkd3d/resource.c
+++ b/libs/vkd3d/resource.c
@@ -193,6 +193,16 @@ HRESULT vkd3d_create_buffer(struct d3d12_device *device,
         external_info.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
         buffer_info.pNext = &external_info;
     }
+#ifdef _WIN32
+    else if (!sparse_resource && (heap_flags & D3D12_HEAP_FLAG_SHARED))
+    {
+        /* Shared committed buffers: memory is exported as an NT handle (D3DKMT on Wine 11). */
+        external_info.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO;
+        external_info.pNext = NULL;
+        external_info.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+        buffer_info.pNext = &external_info;
+    }
+#endif
 
     if (sparse_resource)
     {
@@ -4530,6 +4540,37 @@ HRESULT d3d12_resource_create_committed(struct d3d12_device *device, const D3D12
             allocate_info.heap_desc.Flags &= ~D3D12_HEAP_FLAG_CREATE_NOT_ZEROED;
         }
 
+#ifdef _WIN32
+        if (heap_flags & D3D12_HEAP_FLAG_SHARED)
+        {
+            /* Shared committed buffer: dedicated, exportable allocation registered with D3DKMT,
+             * so CreateSharedHandle() can return a real NT handle (e.g. for CUDA interop). */
+            struct vkd3d_allocate_memory_info memory_info;
+            VkExportMemoryAllocateInfo export_info;
+
+            memset(&export_info, 0, sizeof(export_info));
+            export_info.sType = VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO;
+            export_info.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+
+            memset(&memory_info, 0, sizeof(memory_info));
+            memory_info.memory_requirements.memoryTypeBits = ~0u;
+            memory_info.memory_requirements.alignment = allocate_info.heap_desc.Alignment;
+            memory_info.memory_requirements.size = allocate_info.heap_desc.SizeInBytes;
+            memory_info.heap_properties = allocate_info.heap_desc.Properties;
+            memory_info.heap_flags = allocate_info.heap_desc.Flags;
+            memory_info.vk_memory_priority = allocate_info.vk_memory_priority;
+            memory_info.flags = VKD3D_ALLOCATION_FLAG_GLOBAL_BUFFER | VKD3D_ALLOCATION_FLAG_DEDICATED;
+            memory_info.pNext = &export_info;
+
+            if (FAILED(hr = vkd3d_allocate_memory(device, &device->memory_allocator, &memory_info, &object->mem)))
+                goto fail;
+
+            d3d12_resource_open_export_kmt(object, device, &object->mem);
+            if (!object->kmt_local)
+                WARN("Shared committed buffer %p could not be registered with D3DKMT.\n", object);
+        }
+        else
+#endif
         if (FAILED(hr = vkd3d_allocate_heap_memory(device,
                 &device->memory_allocator, &allocate_info, &object->mem)))
             goto fail;
